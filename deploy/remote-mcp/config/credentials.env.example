# OPTIONAL local record only. Copy to credentials.local.env before entering secrets.
# ssh and the MCP service do not read these variables automatically.
# Prefer entering passwords / key passphrases interactively when connecting.
SSH_PASSWORD=REPLACE_WITH_SERVER_PASSWORD_IF_NEEDED
SSH_KEY_PASSPHRASE=REPLACE_WITH_KEY_PASSPHRASE_IF_NEEDED

# Put the actual private-key file in the ignored keys/ directory, not in this template.
# Never place the Codex MCP client bearer token in the server runtime settings.
